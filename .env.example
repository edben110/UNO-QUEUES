# ---- Conexión RabbitMQ (la usan los clientes para conectarse) ----
# IP LAN del anfitrión (desde la que los clientes se conectan)
RABBITMQ_HOST=192.168.175.106
RABBITMQ_PORT=5672
# Usuario creado en RabbitMQ para la red (NO usar guest desde otro equipo)
RABBITMQ_USER=juega
RABBITMQ_PASS=password123

# ---- Anfitrión (host) ----
# IP que el host muestra en pantalla (forzada; si se omite se detecta sola)
RABBITMQ_LAN_IP=192.168.175.106
# Nombre del host (opcional; si se omite lo pide al arrancar)
# HOST_NAME=edben
# Game ID fijo para el host (opcional; si se omite se genera uno)
# GAME_ID=uno-partida

# ---- Cliente ----
# Game ID de la partida a la que unirse (lo muestra el host)
# GAME_ID=uno-partida
